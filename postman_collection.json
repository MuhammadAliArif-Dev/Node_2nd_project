				{
					"name": "SnapTrade Webhook - CONNECTION_ADDED (Triggers BullMQ Queue)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Automatically calculates HMAC SHA-256 Signature for Webhook Security",
									"const consumerKey = pm.collectionVariables.get(\"snaptradeConsumerKey\");",
									"if (!consumerKey || consumerKey === \"PASTE_YOUR_SNAPTRADE_CONSUMER_KEY_HERE\") {",
									"    console.warn(\"Please set 'snaptradeConsumerKey' in collection variables to calculate valid Signature.\");",
									"} else {",
									"    const rawBody = pm.request.body.raw || \"\";",
									"    const hash = CryptoJS.HmacSHA256(rawBody, consumerKey);",
									"    const signature = CryptoJS.enc.Base64.stringify(hash);",
									"    pm.request.headers.upsert({ key: \"Signature\", value: signature });",
									"    console.log(\"Calculated Signature:\", signature);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Signature",
								"value": "AUTO_CALCULATED_BY_PREREQUEST_SCRIPT",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventType\": \"CONNECTION_ADDED\",\n  \"userId\": \"user_6\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/snaptrade/webhook",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"snaptrade",
								"webhook"
							]
						},
						"description": "Simulates CONNECTION_ADDED event from SnapTrade. Automatically computes HMAC SHA-256 signature using the collection variable 'snaptradeConsumerKey'. Pushes job to BullMQ Redis Queue."
					},
					"response": []
				},
				{
					"name": "SnapTrade Webhook - NEW_ACCOUNT_AVAILABLE (Triggers BullMQ Queue)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Automatically calculates HMAC SHA-256 Signature for Webhook Security",
									"const consumerKey = pm.collectionVariables.get(\"snaptradeConsumerKey\");",
									"if (!consumerKey || consumerKey === \"PASTE_YOUR_SNAPTRADE_CONSUMER_KEY_HERE\") {",
									"    console.warn(\"Please set 'snaptradeConsumerKey' in collection variables to calculate valid Signature.\");",
									"} else {",
									"    const rawBody = pm.request.body.raw || \"\";",
									"    const hash = CryptoJS.HmacSHA256(rawBody, consumerKey);",
									"    const signature = CryptoJS.enc.Base64.stringify(hash);",
									"    pm.request.headers.upsert({ key: \"Signature\", value: signature });",
									"    console.log(\"Calculated Signature:\", signature);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Signature",
								"value": "AUTO_CALCULATED_BY_PREREQUEST_SCRIPT",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventType\": \"NEW_ACCOUNT_AVAILABLE\",\n  \"userId\": \"user_6\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/snaptrade/webhook",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"snaptrade",
								"webhook"
							]
						},
						"description": "Simulates NEW_ACCOUNT_AVAILABLE event from SnapTrade. Automatically computes HMAC SHA-256 signature using the collection variable 'snaptradeConsumerKey'. Pushes job to BullMQ Redis Queue."
					},
					"response": []
				},
				{
					"name": "SnapTrade Webhook - Other Event (Acknowledged / Ignored)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const consumerKey = pm.collectionVariables.get(\"snaptradeConsumerKey\");",
									"if (consumerKey && consumerKey !== \"PASTE_YOUR_SNAPTRADE_CONSUMER_KEY_HERE\") {",
									"    const rawBody = pm.request.body.raw || \"\";",
									"    const hash = CryptoJS.HmacSHA256(rawBody, consumerKey);",
									"    const signature = CryptoJS.enc.Base64.stringify(hash);",
									"    pm.request.headers.upsert({ key: \"Signature\", value: signature });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Signature",
								"value": "AUTO_CALCULATED_BY_PREREQUEST_SCRIPT",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventType\": \"ACCOUNT_HOLDINGS_UPDATED\",\n  \"userId\": \"user_6\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/snaptrade/webhook",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"snaptrade",
								"webhook"
							]
						},
						"description": "Tests webhook behavior for events that do not trigger sync (e.g. ACCOUNT_HOLDINGS_UPDATED). Should return 200 with received: true."
					},
					"response": []
				}
