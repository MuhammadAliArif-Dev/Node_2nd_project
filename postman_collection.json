						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventType\": \"TEST_WEBHOOK\",\n  \"userId\": \"user_1\",\n  \"eventTimestamp\": \"2026-10-08T12:00:00.000Z\",\n  \"webhookId\": \"test-webhook-uuid\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/snaptrade/webhook",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"snaptrade",
								"webhook"
							]
