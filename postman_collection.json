		{
			"name": "2. SnapTrade & Alpaca Integration",
			"item": [
				{
					"name": "Connect Alpaca (Protected - Generates Portal URL)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/snaptrade/connect-alpaca",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"snaptrade",
								"connect-alpaca"
							]
						},
						"description": "Protected route. Registers user on SnapTrade (or reuses stored userSecret from DB) and returns a redirectURI to connect Alpaca Paper."
					},
					"response": []
				},
